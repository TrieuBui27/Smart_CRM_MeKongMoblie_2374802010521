<mxfile host="app.diagrams.net"><diagram name="Use Case L2" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1120" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Hệ thống Smart CRM – Luồng L2: Tiếp nhận và phân loại yêu cầu bảo hành" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="20" width="690" height="770" as="geometry"/></mxCell><mxCell id="n3" value="Nhân viên tiếp nhận" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="40" height="72" as="geometry"/></mxCell><mxCell id="n4" value="Bộ lập lịch<br>«system»" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="110" width="40" height="72" as="geometry"/></mxCell><mxCell id="n5" value="Quản lý trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="420" width="40" height="72" as="geometry"/></mxCell><mxCell id="n6" value="Kỹ thuật viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="640" width="40" height="72" as="geometry"/></mxCell><mxCell id="n7" value="UC2. Ghi nhận khách hàng và thiết bị mới" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="55" width="250" height="62" as="geometry"/></mxCell><mxCell id="n8" value="UC1. Tra cứu khách hàng theo số điện thoại" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="175" width="250" height="62" as="geometry"/></mxCell><mxCell id="n9" value="UC3. Tạo phiếu bảo hành" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="295" width="250" height="62" as="geometry"/></mxCell><mxCell id="n10" value="UC4. Phân loại nhóm sự cố và mức ưu tiên" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="235" y="415" width="250" height="62" as="geometry"/></mxCell><mxCell id="n11" value="UC5. Sinh hạn cam kết" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="295" width="250" height="62" as="geometry"/></mxCell><mxCell id="n12" value="UC9. Đánh dấu phiếu quá hạn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="110" width="250" height="62" as="geometry"/></mxCell><mxCell id="n13" value="UC8. Kiểm tra tình trạng bảo hành" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="415" width="250" height="62" as="geometry"/></mxCell><mxCell id="n14" value="UC6. Xem danh sách phiếu bảo hành" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="570" width="250" height="62" as="geometry"/></mxCell><mxCell id="n15" value="UC7. Chuyển trạng thái phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="690" width="250" height="62" as="geometry"/></mxCell><mxCell id="n16" value="CHÚ THÍCH KÝ HIỆU<br>Khung đậm = ranh giới hệ thống<br>Hình người = actor (ngoài ranh giới)<br>Actor «system» = actor không phải người<br>Elip = use case (động từ + đối tượng)<br>Đường liền = association (actor dùng use case)<br>Đường đứt «include» = use case gốc luôn gọi use case đích<br>Đường đứt «extend» = mũi tên từ use case mở rộng tới use case gốc, chỉ xảy ra khi có điều kiện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="12" y="560" width="190" height="225" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n3" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n5" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n6" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="html=1;rounded=0;fontSize=10;endArrow=none;" edge="1" parent="1" source="n6" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="«extend»" style="html=1;rounded=0;fontSize=10;endArrow=open;dashed=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="«include»" style="html=1;rounded=0;fontSize=10;endArrow=open;dashed=1;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="«include»" style="html=1;rounded=0;fontSize=10;endArrow=open;dashed=1;" edge="1" parent="1" source="n9" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="«include»" style="html=1;rounded=0;fontSize=10;endArrow=open;dashed=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="«include»" style="html=1;rounded=0;fontSize=10;endArrow=open;dashed=1;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>